#!/usr/bin/env php
<?php

declare(strict_types=1);

use Leash\Console\Application;
use Leash\Output\StreamOutput;

$autoloaders = [
    __DIR__ . '/../vendor/autoload.php',     // running from a clone
    __DIR__ . '/../../../autoload.php',      // installed as a dependency
];

foreach ($autoloaders as $autoloader) {
    if (file_exists($autoloader)) {
        require $autoloader;
        break;
    }
}

$application = new Application(new StreamOutput(STDOUT));

exit($application->run(array_slice($argv, 1)));
